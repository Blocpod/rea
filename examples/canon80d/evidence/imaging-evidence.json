  "scope": "Offline source inspection and theoretical arithmetic; no physical camera, no runtime firmware verification.",
  "findings": [
    {
      "id": "IMG-001",
      "evidence_type": "observed_source",
      "claim": "80D build target is firmware 1.0.3, ARMv7-R Thumb, with boot-d678.o.",
      "source_path": "platform/80D.103/Makefile",
      "line_start": 1,
      "line_end": 25,
      "url": "https://github.com/reticulatedpines/magiclantern_simplified/blob/142472e95054d73640f50789ac0fd66325499d82/platform/80D.103/Makefile#L1",
      "limitation": "A target definition is not proof of a camera-qualified image."
    },
    {
      "id": "IMG-002",
      "evidence_type": "observed_source",
      "claim": "EDMAC setup, routing, start/abort and callbacks are no-op overrides; engine writes are no-ops; shamem_read returns zero.",
      "source_path": "platform/80D.103/function_overrides.c",
      "line_start": 112,
      "line_end": 181,
      "url": "https://github.com/reticulatedpines/magiclantern_simplified/blob/142472e95054d73640f50789ac0fd66325499d82/platform/80D.103/function_overrides.c#L112",
      "limitation": "Raw-frame transfer and sensor register control require actual implementations before generic recorder code can be useful."
    },
    {
      "id": "IMG-003",
      "evidence_type": "observed_source",
      "claim": "80D MVR recording constants are explicitly marked junk; HD DMA address is zero.",
      "source_path": "platform/80D.103/consts.h",
      "line_start": 78,
      "line_end": 131,
      "url": "https://github.com/reticulatedpines/magiclantern_simplified/blob/142472e95054d73640f50789ac0fd66325499d82/platform/80D.103/consts.h#L78",
      "limitation": "No reliable H.264 recorder/encoder control is established by these definitions."
    },
    {
      "id": "IMG-004",
      "evidence_type": "observed_source",
      "claim": "State-object hooks disabled and programmatic image capture explicitly marked not working.",
      "source_path": "platform/80D.103/features.h",
      "line_start": 26,
      "line_end": 42,
      "url": "https://github.com/reticulatedpines/magiclantern_simplified/blob/142472e95054d73640f50789ac0fd66325499d82/platform/80D.103/features.h#L26",
      "limitation": "A shutter automation extension must fix capture callbacks and failure cases first."
    },
    {
      "id": "IMG-005",
      "evidence_type": "observed_source",
      "claim": "SRM memory pool support is marked untested; required buffer size not found.",
      "source_path": "platform/80D.103/internals.h",
      "line_start": 17,
      "line_end": 19,
      "url": "https://github.com/reticulatedpines/magiclantern_simplified/blob/142472e95054d73640f50789ac0fd66325499d82/platform/80D.103/internals.h#L17",
      "limitation": "Memory stubs existing does not establish buffer ownership, alignment, cache coherency or capture lifetime."
    },
    {
      "id": "IMG-006",
      "evidence_type": "observed_source",
      "claim": "Only bench and file_man are included; raw recording and crop modules are hidden.",
      "source_path": "platform/80D.103/modules.hidden",
      "line_start": 1,
      "line_end": 18,
      "url": "https://github.com/reticulatedpines/magiclantern_simplified/blob/142472e95054d73640f50789ac0fd66325499d82/platform/80D.103/modules.hidden#L1",
      "limitation": "Unhiding modules does not implement their missing primitives."
    },
    {
      "id": "IMG-007",
      "evidence_type": "observed_source",
      "claim": "Picture-style selection/settings are whitelisted; MVR recording property handlers are denied.",
      "source_path": "platform/80D.103/property_whitelist.h",
      "line_start": 28,
      "line_end": 50,
      "url": "https://github.com/reticulatedpines/magiclantern_simplified/blob/142472e95054d73640f50789ac0fd66325499d82/platform/80D.103/property_whitelist.h#L28",
      "limitation": "This is a narrower control surface than a 3D LUT engine."
    },
    {
      "id": "IMG-008",
      "evidence_type": "observed_source",
      "claim": "The 80D uses 11 picture styles. Shared picture style struct exposes contrast/sharpness/saturation/color tone plus fineness/threshold.",
