      "line_start": 97,
      "line_end": 110,
      "url": "https://github.com/reticulatedpines/magiclantern_simplified/blob/142472e95054d73640f50789ac0fd66325499d82/src/picstyle.c#L97",
      "limitation": "Not an arbitrary matrix or cube-LUT API. 80D NUM_PICSTYLES=11 is in consts.h:82."
    },
    {
      "id": "IMG-009",
      "evidence_type": "observed_source",
      "claim": "MLV Lite disables lossless compression when DIGIC generation is not 5.",
